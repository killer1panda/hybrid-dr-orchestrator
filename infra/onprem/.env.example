# Copy to infra/onprem/.env (gitignored), fill in, then: chmod 600 infra/onprem/.env
# No quotes around values. Never paste these values into chat or commit them.
POSTGRES_DB=dr_app
POSTGRES_USER=dr_user
# Use hex (openssl rand -hex 24): the app builds a connection URL, so / @ : in passwords break it.
POSTGRES_PASSWORD=
# Access key of the dr-onprem-backup-writer IAM user (NOT your admin user)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-2
DR_ALLOWED_ACCOUNT_ID=758579869433
DR_BACKUP_BUCKET=hybrid-dr-backups-758579869433-ap-southeast-2
# Encrypts base backups and WAL (openssl rand -base64 32). Keep a copy in your password manager:
# without it the backups cannot be restored, including from AWS during a real disaster.
BACKUP_ENCRYPTION_PASSPHRASE=
# Optional Slack or Discord webhook for restore-test failures
DR_ALERT_WEBHOOK_URL=
