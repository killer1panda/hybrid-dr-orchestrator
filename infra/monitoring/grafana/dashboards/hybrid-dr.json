    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 100,
      "title": "Site Health & Multi-Signal Quorum Telemetry",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "description": "Layer 7 HTTP /healthz endpoint probe",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": { "color": "red", "text": "DOWN" },
                "1": { "color": "green", "text": "HEALTHY" }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "title": "Application (L7 HTTP)",
      "type": "stat",
      "targets": [
        {
          "expr": "probe_success{instance=\"http://onprem-web/healthz\"}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "description": "Layer 4 TCP connect probe on port 80",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": { "color": "red", "text": "DOWN" },
                "1": { "color": "green", "text": "HEALTHY" }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "id": 2,
      "title": "Network (L4 TCP:80)",
      "type": "stat",
      "targets": [
        {
          "expr": "probe_success{instance=\"onprem-web:80\"}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "description": "PostgreSQL database TCP port 5432 probe",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": { "color": "red", "text": "DOWN" },
                "1": { "color": "green", "text": "HEALTHY" }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "id": 3,
      "title": "Database (TCP:5432)",
      "type": "stat",
      "targets": [
        {
          "expr": "probe_success{instance=\"onprem-db:5432\"}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "description": "Multi-Signal Quorum Engine consensus health",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": { "color": "green", "text": "NORMAL" },
                "1": { "color": "red", "text": "DISASTER" }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "id": 4,
      "title": "Quorum Status",
      "type": "stat",
      "targets": [
        {
          "expr": "1 - (probe_success{instance=\"http://onprem-web/healthz\"} * probe_success{instance=\"onprem-web:80\"})",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 101,
      "title": "Probe Latencies & Continuity",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "id": 5,
      "title": "Blackbox Probe Duration History",
      "type": "timeseries",
      "targets": [
        {
          "expr": "probe_duration_seconds",
          "legendFormat": "{{instance}} ({{job}})",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["hybrid-dr", "disaster-recovery", "prometheus"],
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m"]
  },
  "timezone": "browser",
  "title": "Hybrid Cloud DR: Operational Overview",
  "uid": "hybrid-dr-overview",
  "version": 1
